{
  "Procedure": {
    "prefix": "procedure",
    "description": "A whole procedure",
    "body": [
      "procedure ${1:IDENTIFIER} {",
      "\tname     \"${2:Crew-facing title}\"",
      "\tcategory ${3|abnormal,normal,emergency,reference|}",
      "",
      "\t$0",
      "}"
    ]
  },

  "name": {
    "prefix": "name",
    "description": "Crew-facing title (required)",
    "body": ["name \"${1:Crew-facing title}\""]
  },
  "description": {
    "prefix": "description",
    "description": "Longer description",
    "body": ["description \"${1:What this procedure does}\""]
  },
  "category": {
    "prefix": "category",
    "description": "normal | abnormal | emergency | reference (required)",
    "body": ["category ${1|abnormal,normal,emergency,reference|}"]
  },
  "priority": {
    "prefix": "priority",
    "description": "0-255, default 0",
    "body": ["priority ${1:80}"]
  },
  "revision": {
    "prefix": "revision",
    "description": "0-65535, default 0",
    "body": ["revision ${1:1}"]
  },
  "trigger": {
    "prefix": "trigger",
    "description": "Pure condition a host may evaluate every frame",
    "body": ["trigger ${1:system.state} ${2|<,<=,>,>=,==,!=|} ${3:0}"]
  },
  "require": {
    "prefix": "require",
    "description": "Precondition checked before any step runs",
    "body": ["require ${1:system.state} \"${2:why it must hold}\""]
  },

  "check": {
    "prefix": "check",
    "description": "Ask for an item to be verified",
    "body": ["check ${1:CONTROL}"]
  },
  "set": {
    "prefix": "set",
    "description": "Move a control to a position or value",
    "body": ["set ${1:CONTROL} = ${2:ON}"]
  },
  "start": {
    "prefix": "start",
    "description": "set CONTROL = ON",
    "body": ["start ${1:CONTROL}"]
  },
  "stop": {
    "prefix": "stop",
    "description": "set CONTROL = OFF",
    "body": ["stop ${1:CONTROL}"]
  },
  "open": {
    "prefix": "open",
    "description": "set CONTROL = OPEN",
    "body": ["open ${1:CONTROL}"]
  },
  "close": {
    "prefix": "close",
    "description": "set CONTROL = CLOSED",
    "body": ["close ${1:CONTROL}"]
  },
  "notify": {
    "prefix": "notify",
    "description": "Send a message to the host",
    "body": ["notify \"${1:message}\""]
  },
  "call": {
    "prefix": "call",
    "description": "Run another procedure to completion",
    "body": ["call ${1:PROCEDURE}"]
  },

  "wait": {
    "prefix": "wait",
    "description": "Yield until a condition holds",
    "body": ["wait ${1:system.state} ${2|>,>=,<,<=,==,!=|} ${3:0}"]
  },
  "wait with timeout": {
    "prefix": "waitt",
    "description": "Wait, then carry on if it times out",
    "body": ["wait ${1:system.state} ${2|>,>=,<,<=,==,!=|} ${3:0} timeout ${4:30s}"]
  },
  "wait or fail": {
    "prefix": "waitf",
    "description": "Wait, and fail the procedure if it times out",
    "body": ["wait ${1:system.state} ${2|>,>=,<,<=,==,!=|} ${3:0} timeout ${4:30s} else fail"]
  },

  "if": {
    "prefix": "if",
    "description": "Branch",
    "body": ["if ${1:condition} {", "\t$0", "}"]
  },
  "if else": {
    "prefix": "ifelse",
    "description": "Branch with an alternative",
    "body": ["if ${1:condition} {", "\t$2", "} else {", "\t$0", "}"]
  },
  "else if": {
    "prefix": "elseif",
    "description": "Further branch",
    "body": ["else if ${1:condition} {", "\t$0", "}"]
  },

  "complete": {
    "prefix": "complete",
    "description": "Finish successfully",
    "body": ["complete"]
  },
  "complete when": {
    "prefix": "completew",
    "description": "Wait for a criterion, then finish — a timeout here fails the procedure",
    "body": ["complete when ${1:system.state} ${2|>,>=,<,<=,==,!=|} ${3:0} timeout ${4:30s}"]
  },
  "fail": {
    "prefix": "fail",
    "description": "Stop unsuccessfully",
    "body": ["fail \"${1:reason}\""]
  }
}
