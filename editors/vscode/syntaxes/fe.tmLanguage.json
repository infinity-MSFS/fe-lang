{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flight Engineer",
  "scopeName": "source.fe",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#procedure" },
    { "include": "#metadata" },
    { "include": "#steps" },
    { "include": "#paths" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fe",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fe",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.fe",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.fe",
          "match": "\\\\[\"\\\\nt]"
        },
        {
          "comment": "The lexer accepts \\\" \\\\ \\n \\t and nothing else.",
          "name": "invalid.illegal.escape.fe",
          "match": "\\\\."
        }
      ]
    },

    "procedure": {
      "match": "\\b(procedure)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.procedure.fe" },
        "2": { "name": "entity.name.function.fe" }
      }
    },

    "metadata": {
      "patterns": [
        {
          "match": "^\\s*(category)\\s+(normal|abnormal|emergency|reference)\\b",
          "captures": {
            "1": { "name": "keyword.other.metadata.fe" },
            "2": { "name": "constant.language.category.fe" }
          }
        },
        {
          "comment": "`category` takes one of four words; anything else is rejected by the compiler.",
          "match": "^\\s*(category)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.metadata.fe" },
            "2": { "name": "invalid.illegal.category.fe" }
          }
        },
        {
          "match": "^\\s*(name|description|priority|revision|trigger|require)\\b",
          "captures": {
            "1": { "name": "keyword.other.metadata.fe" }
          }
        }
      ]
    },

    "steps": {
      "patterns": [
        {
          "match": "^\\s*(check|start|stop|open|close)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.step.fe" },
            "2": { "name": "variable.other.constant.control.fe" }
          }
        },
        {
          "match": "^\\s*(set)\\s+([A-Za-z_][A-Za-z0-9_.]*)\\s*(=)\\s*([0-9]+(?:\\.[0-9]+)?)",
          "captures": {
            "1": { "name": "keyword.control.step.fe" },
            "2": { "name": "variable.other.constant.control.fe" },
            "3": { "name": "keyword.operator.assignment.fe" },
            "4": { "name": "constant.numeric.fe" }
          }
        },
        {
          "match": "^\\s*(set)\\s+([A-Za-z_][A-Za-z0-9_.]*)\\s*(=)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.step.fe" },
            "2": { "name": "variable.other.constant.control.fe" },
            "3": { "name": "keyword.operator.assignment.fe" },
            "4": { "name": "support.constant.position.fe" }
          }
        },
        {
          "match": "^\\s*(set)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.step.fe" },
            "2": { "name": "variable.other.constant.control.fe" }
          }
        },
        {
          "match": "^\\s*(call)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.step.fe" },
            "2": { "name": "entity.name.function.fe" }
          }
        }
      ]
    },

    "paths": {
      "comment": "A dotted registry key. Matched before the keyword rules so that `hydraulic.name.check` stays a path — keywords are contextual in this language.",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)+",
      "name": "variable.other.property.fe"
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fe",
          "match": "\\b(if|else|when|wait|timeout|complete|fail|notify|check|set|start|stop|open|close|call)\\b"
        }
      ]
    },

    "literals": {
      "patterns": [
        {
          "match": "\\b([0-9]+(?:\\.[0-9]+)?)(ms|s|m)\\b",
          "captures": {
            "1": { "name": "constant.numeric.fe" },
            "2": { "name": "keyword.other.unit.fe" }
          }
        },
        {
          "name": "constant.language.boolean.fe",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.fe",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.fe",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.comparison.fe",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.fe",
          "match": "="
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "comment": "A control or position name written on its own, e.g. after a verb this grammar did not anchor.",
          "name": "variable.other.constant.control.fe",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.property.fe",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
